# Tiny egress-allowlist proxy used by `claude-sandbox --net restricted`.
# The allowlist is mounted at runtime (/etc/tinyproxy/allowlist), so editing it
# never needs a rebuild.
FROM docker.io/library/debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends tinyproxy \
    && rm -rf /var/lib/apt/lists/*
COPY tinyproxy.conf /etc/tinyproxy/tinyproxy.conf
USER tinyproxy
EXPOSE 3128
ENTRYPOINT ["tinyproxy", "-d", "-c", "/etc/tinyproxy/tinyproxy.conf"]
